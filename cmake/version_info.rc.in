#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
    PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@VERSION_INFO_AUTHOR@"
            VALUE "FileDescription",  "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@TARGET_NAME@"
            VALUE "LegalCopyright",   "Copyright (c) @VERSION_INFO_YEAR@ @VERSION_INFO_AUTHOR@. MIT License"
            VALUE "OriginalFilename", "@TARGET_NAME@.exe"
            VALUE "ProductName",      "@PROJECT_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@+@VERSION_INFO_COMMIT_SHORT@"
            VALUE "Comments",         "@PROJECT_HOMEPAGE_URL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
