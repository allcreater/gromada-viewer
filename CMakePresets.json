{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "4.2"
      }
    },
    {
      "name": "base-cl",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "environment": {
        "CXXFLAGS": "/W4 /Wall /external:W2 /external:anglebrackets"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "base-clang",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -static-libgcc -static-libstdc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -static-libgcc -static-libstdc++"
      }
    },
    {
      "name": "base-gcc",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-static-libgcc -static-libstdc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-static-libgcc -static-libstdc++"
      }
    },
    {
      "name": "cl-x64-debug",
      "displayName": "MSVC x64 Debug",
      "inherits": "base-cl",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "environment": {
        "CXXFLAGS": "$penv{CXXFLAGS}"
      }
    },
    {
      "name": "cl-x64-release",
      "displayName": "MSVC x64 Release",
      "inherits": "base-cl",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "environment": {
        "CXXFLAGS": "$penv{CXXFLAGS}"
      }
    },
    {
      "name": "clang-x64-release",
      "displayName": "Clang x64 Release",
      "inherits": "base-clang",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-x64-release",
      "displayName": "GCC x64 Release",
      "inherits": "base-gcc",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "emscripten-wasm-release",
      "displayName": "Emscripten WebAssembly Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMSCRIPTEN": "ON",
        "GVIEWER_RENDER_BACKEND" : "GLES3",
        "CMAKE_EXE_LINKER_FLAGS": "-s WASM=1 -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=1MB -s MIN_WEBGL_VERSION=2 -s MAX_WEBGL_VERSION=2 -s INVOKE_RUN=0 -s EXPORTED_RUNTIME_METHODS=\"['callMain', 'FS']\" -s DISABLE_EXCEPTION_CATCHING=0 -s ASSERTIONS=1 --profiling-funcs --shell-file ${sourceDir}/src/web/viewer_shell.html"
      }
    }
  ]
}
